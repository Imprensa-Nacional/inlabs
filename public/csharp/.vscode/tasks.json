{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Compila a aplicação Inlabs.Download",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Inlabs.Download.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-checks",
      "detail": "Compila as verificações offline (e a aplicação)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/tests/Inlabs.Download.Checks.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "verificações offline",
      "detail": "Executa as verificações offline (sem credenciais, sem acesso ao INLABS)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/tests/Inlabs.Download.Checks.csproj"
      ],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
